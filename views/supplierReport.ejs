<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Supplier Transaction Report</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <style>
    :root {
      /* Same CR/DR hues as the dashboard */
      --cr-head: #2a78d6;
      --cr-text: #1c5cab;
      --cr-tint: #eaf2fc;
      --dr-head: #eb6834;
      --dr-text: #b5461a;
      --dr-tint: #fdf0ea;
    }
    body { background-color: #f5f6fa; }
    .container { margin-top: 40px; max-width: 960px; }
    #toastContainer { position: fixed; top: 20px; right: 20px; z-index: 1055; }
    table tbody tr:hover { background-color: #f1f1f1; }

    .num { text-align: right; font-variant-numeric: tabular-nums; }
    #reportTable thead th.col-cr { background-color: var(--cr-head); color: #fff; }
    #reportTable thead th.col-dr { background-color: var(--dr-head); color: #fff; }
    #reportTable td.col-cr { background-color: var(--cr-tint); color: var(--cr-text); font-weight: 600; }
    #reportTable td.col-dr { background-color: var(--dr-tint); color: var(--dr-text); font-weight: 600; }
    #reportTable tfoot td { font-weight: 700; }

    .summary-card { background: #fff; border: 1px solid rgba(0,0,0,.08); border-radius: 10px; padding: 12px 16px; }
    .summary-card .label { font-size: .85rem; color: #52514e; }
    .summary-card .value { font-size: 1.3rem; font-weight: 700; font-variant-numeric: tabular-nums; }
    .summary-card.cr .value { color: var(--cr-text); }
    .summary-card.dr .value { color: var(--dr-text); }
  </style>
</head>
<body>
<div class="container">
  <h2 class="text-center mb-4">Supplier Transaction Report</h2>

  <!-- Filters -->
  <div class="row g-3 align-items-end mb-2">
    <div class="col-12 col-md-5">
      <label for="supplierDropdown" class="form-label">Select Supplier</label>
      <select id="supplierDropdown" class="form-select">
        <option value="">-- Select Supplier --</option>
      </select>
    </div>
    <div class="col-6 col-md-3">
      <label for="fromDate" class="form-label">From</label>
      <input type="date" id="fromDate" class="form-control">
    </div>
    <div class="col-6 col-md-3">
      <label for="toDate" class="form-label">To</label>
      <input type="date" id="toDate" class="form-control">
    </div>
  </div>

  <div class="d-flex flex-wrap gap-2 mb-3">
    <span class="text-muted small align-self-center me-1">Quick range:</span>
    <button type="button" class="btn btn-sm btn-outline-secondary range-preset" data-range="this-month">This month</button>
    <button type="button" class="btn btn-sm btn-outline-secondary range-preset" data-range="last-month">Last month</button>
    <button type="button" class="btn btn-sm btn-outline-secondary range-preset" data-range="last-3-months">Last 3 months</button>
    <button type="button" class="btn btn-sm btn-outline-secondary range-preset" data-range="this-year">This year</button>
    <button type="button" class="btn btn-sm btn-outline-secondary range-preset" data-range="all">All time</button>
  </div>

  <button id="generateReport" class="btn btn-primary mb-2">Generate Report</button>
  <button id="exportExcel" class="btn btn-success mb-2">Export to Excel</button>
  <button id="exportPDF" class="btn btn-danger mb-2">Export to PDF</button>

  <!-- Summary -->
  <div class="row g-2 my-2 d-none" id="summaryRow">
    <div class="col-6 col-md-3"><div class="summary-card"><div class="label">Opening balance</div><div class="value" id="sumOpening"></div></div></div>
    <div class="col-6 col-md-3"><div class="summary-card cr"><div class="label">Total CR (purchases)</div><div class="value" id="sumCr"></div></div></div>
    <div class="col-6 col-md-3"><div class="summary-card dr"><div class="label">Total DR (payments)</div><div class="value" id="sumDr"></div></div></div>
    <div class="col-6 col-md-3"><div class="summary-card"><div class="label">Closing balance</div><div class="value" id="sumClosing"></div></div></div>
  </div>

  <!-- Report Table -->
  <div class="table-responsive">
  <table class="table table-bordered table-striped" id="reportTable">
    <thead class="table-dark">
      <tr>
        <th>#</th>
        <th>Invoice No</th>
        <th>Invoice Date</th>
        <th class="num col-cr">CR (Purchase)</th>
        <th class="num col-dr">DR (Payment)</th>
        <th class="num">Balance</th>
      </tr>
    </thead>
    <tbody id="reportBody">
      <!-- Rows dynamically populated -->
    </tbody>
    <tfoot id="reportFoot"></tfoot>
  </table>
  </div>
</div>

<!-- Toast container -->
<div id="toastContainer"></div>

<!-- Libraries for XLSX and PDF -->
<script src="https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

<script>
  const supplierDropdown = document.getElementById('supplierDropdown');
  const reportBody = document.getElementById('reportBody');
  const reportFoot = document.getElementById('reportFoot');
  const generateBtn = document.getElementById('generateReport');
  const exportExcelBtn = document.getElementById('exportExcel');
  const exportPDFBtn = document.getElementById('exportPDF');
  const fromInput = document.getElementById('fromDate');
  const toInput = document.getElementById('toDate');

  let currentReport = []; // store the generated report for export
  let currentMeta = null;  // supplier name, range and totals of the generated report

  const fmt = (n) => Number(n || 0).toLocaleString('en-IN', { maximumFractionDigits: 2 });

  const escapeHtml = (s) => String(s ?? '').replace(/[&<>"']/g, c => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
  }[c]));

  // Local date -> "YYYY-MM-DD" for <input type="date">
  const toISODate = (d) =>
    `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;

  const rangeLabel = (from, to) => {
    if (from && to) return `${from} to ${to}`;
    if (from) return `From ${from}`;
    if (to) return `Up to ${to}`;
    return 'All time';
  };

  // Load suppliers
  async function loadSuppliers() {
    try {
      const res = await fetch('/api/supplier');
      const suppliers = await res.json();
      suppliers.forEach(s => {
        const option = document.createElement('option');
        option.value = s.supplier_id;
        option.text = s.supplier_name;
        supplierDropdown.add(option);
      });
    } catch(err) {
      showToast("Error loading suppliers", true);
      console.error(err);
    }
  }

  // Quick range presets
  document.querySelectorAll('.range-preset').forEach(btn => {
    btn.addEventListener('click', () => {
      const now = new Date();
      let from = '', to = '';
      switch (btn.dataset.range) {
        case 'this-month':
          from = toISODate(new Date(now.getFullYear(), now.getMonth(), 1));
          to = toISODate(now);
          break;
        case 'last-month':
          from = toISODate(new Date(now.getFullYear(), now.getMonth() - 1, 1));
          to = toISODate(new Date(now.getFullYear(), now.getMonth(), 0));
          break;
        case 'last-3-months':
          from = toISODate(new Date(now.getFullYear(), now.getMonth() - 2, 1));
          to = toISODate(now);
          break;
        case 'this-year':
          from = toISODate(new Date(now.getFullYear(), 0, 1));
          to = toISODate(now);
          break;
      }
      fromInput.value = from;
      toInput.value = to;
      if (supplierDropdown.value) generateReport();
    });
  });

  async function generateReport() {
    const supplier_id = supplierDropdown.value;
    if (!supplier_id) return showToast("Please select a supplier", true);

    const from = fromInput.value;
    const to = toInput.value;
    if (from && to && from > to) return showToast("'From' date must be before 'To' date", true);

    try {
      const params = new URLSearchParams();
      if (from) params.set('from', from);
      if (to) params.set('to', to);

      const res = await fetch(`/api/supplier/report/${supplier_id}?${params}`);
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || `HTTP error ${res.status}`);

      currentReport = [];
      currentMeta = {
        supplier_name: data.supplier_name,
        range: rangeLabel(data.from, data.to),
        opening_balance: data.opening_balance,
        total_CR: data.total_CR,
        total_DR: data.total_DR,
        closing_balance: data.closing_balance
      };

      let idx = 1;
      const rows = [];

      // Opening / brought-forward balance row
      const openingText = data.from ? 'Balance Brought Forward' : 'Opening Balance';
      rows.push(`
        <tr>
          <td>${idx}</td>
          <td colspan="4"><strong>${openingText}</strong></td>
          <td class="num">${fmt(data.opening_balance)}</td>
        </tr>
      `);
      currentReport.push({ "#": idx, "Invoice No": openingText, "Invoice Date": "", "CR": "", "DR": "", "Balance": data.opening_balance });
      idx++;

      // Transaction rows
      data.report.forEach(tx => {
        const date = new Date(tx.invoice_date).toLocaleDateString();
        const cr = tx.payment_type === 'CR' ? tx.amount : '';
        const dr = tx.payment_type === 'DR' ? tx.amount : '';
        rows.push(`
          <tr>
            <td>${idx}</td>
            <td>${escapeHtml(tx.invoice_no)}</td>
            <td>${date}</td>
            <td class="num col-cr">${cr === '' ? '' : fmt(cr)}</td>
            <td class="num col-dr">${dr === '' ? '' : fmt(dr)}</td>
            <td class="num">${fmt(tx.balance)}</td>
          </tr>
        `);
        currentReport.push({ "#": idx, "Invoice No": tx.invoice_no, "Invoice Date": date, "CR": cr, "DR": dr, "Balance": tx.balance });
        idx++;
      });

      if (!data.report.length) {
        rows.push(`<tr><td colspan="6" class="text-center text-muted">No transactions in this range</td></tr>`);
      }

      reportBody.innerHTML = rows.join('');
      reportFoot.innerHTML = `
        <tr>
          <td colspan="3" class="text-end">Total</td>
          <td class="num col-cr">${fmt(data.total_CR)}</td>
          <td class="num col-dr">${fmt(data.total_DR)}</td>
          <td class="num">${fmt(data.closing_balance)}</td>
        </tr>
      `;

      document.getElementById('sumOpening').textContent = fmt(data.opening_balance);
      document.getElementById('sumCr').textContent = fmt(data.total_CR);
      document.getElementById('sumDr').textContent = fmt(data.total_DR);
      document.getElementById('sumClosing').textContent = fmt(data.closing_balance);
      document.getElementById('summaryRow').classList.remove('d-none');
    } catch(err) {
      showToast("Error fetching report", true);
      console.error(err);
    }
  }

  generateBtn.addEventListener('click', generateReport);

  const fileSuffix = () =>
    `${(currentMeta?.supplier_name || 'Supplier').replace(/[^\w-]+/g, '_')}_${(currentMeta?.range || '').replace(/[^\w-]+/g, '_')}`;

  // Export to Excel
  exportExcelBtn.addEventListener('click', () => {
    if (!currentReport.length) return showToast("No data to export", true);
    const ws = XLSX.utils.json_to_sheet([
      ...currentReport,
      { "#": "", "Invoice No": "Total", "Invoice Date": "", "CR": currentMeta.total_CR, "DR": currentMeta.total_DR, "Balance": currentMeta.closing_balance }
    ]);
    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, "Report");
    XLSX.writeFile(wb, `SupplierTransactionReport_${fileSuffix()}.xlsx`);
  });

  // Export to PDF
  exportPDFBtn.addEventListener('click', () => {
    if (!currentReport.length) return showToast("No data to export", true);
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF();
    doc.text("Supplier Transaction Report", 14, 16);
    doc.setFontSize(10);
    doc.text(`${currentMeta.supplier_name}  |  ${currentMeta.range}`, 14, 23);

    const rows = currentReport.map(r => [r["#"], r["Invoice No"], r["Invoice Date"], r["CR"], r["DR"], r["Balance"]]);
    doc.autoTable({
      head: [["#", "Invoice No", "Invoice Date", "CR (Purchase)", "DR (Payment)", "Balance"]],
      body: rows,
      foot: [["", "Total", "", currentMeta.total_CR, currentMeta.total_DR, currentMeta.closing_balance]],
      showFoot: 'lastPage',
      startY: 28,
      columnStyles: {
        3: { halign: 'right', textColor: [28, 92, 171] },
        4: { halign: 'right', textColor: [181, 70, 26] },
        5: { halign: 'right' }
      },
      didParseCell: (cell) => {
        if (cell.section !== 'head') return;
        if (cell.column.index === 3) cell.cell.styles.fillColor = [42, 120, 214];
        if (cell.column.index === 4) cell.cell.styles.fillColor = [235, 104, 52];
      }
    });
    doc.save(`SupplierTransactionReport_${fileSuffix()}.pdf`);
  });

  // Toast
  function showToast(message, isError=false){
    const toastContainer = document.getElementById('toastContainer');
    const toast = document.createElement('div');
    toast.className = `toast align-items-center text-bg-${isError?'danger':'success'} border-0 mb-2`;
    toast.setAttribute('role','alert');
    toast.setAttribute('aria-live','assertive');
    toast.setAttribute('aria-atomic','true');
    toast.innerHTML = `<div class="d-flex"><div class="toast-body">${message}</div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button></div>`;
    toastContainer.appendChild(toast);
    const bsToast = new bootstrap.Toast(toast,{delay:3000});
    bsToast.show();
    bsToast._element.addEventListener('hidden.bs.toast',()=>toast.remove());
  }

  loadSuppliers();
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
</body>
</html>
