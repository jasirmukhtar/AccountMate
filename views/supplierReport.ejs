<%- include('partials/header', { title: 'Supplier Report', active: 'supplier-report' }) %>

<main class="page page--medium">
  <h2 class="text-center mb-4">Supplier Transaction Report</h2>

  <div class="panel mb-3">
    <div class="mb-3">
      <label for="supplierDropdown" class="form-label">Select Supplier</label>
      <select id="supplierDropdown" class="form-select"></select>
    </div>

    <%- include('partials/dateRange', {
      id: 'reportRange',
      presets: ['this-month', 'last-month', 'last-3-months', 'this-year', 'all'],
      active: 'all'
    }) %>

    <div class="d-flex flex-wrap gap-2 mt-3">
      <button id="generateReport" class="btn btn-primary">Generate Report</button>
      <button id="exportExcel" class="btn btn-success">Export to Excel</button>
      <button id="exportPDF" class="btn btn-danger">Export to PDF</button>
    </div>
  </div>

  <!-- Summary -->
  <div class="row g-2 mb-3 d-none" id="summaryRow">
    <div class="col-6 col-md-3"><div class="panel stat stat--compact"><div class="stat-label">Opening balance</div><div class="stat-value" id="sumOpening"></div></div></div>
    <div class="col-6 col-md-3"><div class="panel stat stat--compact stat--cr"><div class="stat-label">Total CR (purchases)</div><div class="stat-value" id="sumCr"></div></div></div>
    <div class="col-6 col-md-3"><div class="panel stat stat--compact stat--dr"><div class="stat-label">Total DR (payments)</div><div class="stat-value" id="sumDr"></div></div></div>
    <div class="col-6 col-md-3"><div class="panel stat stat--compact"><div class="stat-label">Closing balance</div><div class="stat-value" id="sumClosing"></div></div></div>
  </div>

  <div class="table-responsive">
    <table class="table table-bordered table-striped" id="reportTable">
      <thead class="table-dark">
        <tr>
          <th>#</th>
          <th>Invoice No</th>
          <th>Invoice Date</th>
          <th class="num col-cr">CR (Purchase)</th>
          <th class="num col-dr">DR (Payment)</th>
          <th class="num">Balance</th>
        </tr>
      </thead>
      <tbody id="reportBody"></tbody>
      <tfoot id="reportFoot"></tfoot>
    </table>
  </div>
</main>

<%- include('partials/footer', { vendor: ['xlsx', 'jspdf'], scripts: ['/js/pages/supplierReport.js'] }) %>
