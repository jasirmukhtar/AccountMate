<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AccountMate - Dashboard</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <style>
    :root {
      --page: #f4f6f8;
      --surface: #ffffff;
      --text-primary: #0b0b0b;
      --text-secondary: #52514e;
      --text-muted: #898781;
      --grid: #e1e0d9;
      --border: rgba(11, 11, 11, 0.10);
      --cr: #2a78d6;   /* purchases */
      --dr: #eb6834;   /* payments */
    }

    body {
      background-color: var(--page);
      color: var(--text-primary);
      font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    }

    .dashboard {
      max-width: 1200px;
      margin: 0 auto;
      padding: 24px 16px 48px;
    }

    .dashboard-header h2 {
      font-weight: 700;
      margin: 0;
    }

    .dashboard-header .period {
      color: var(--text-secondary);
    }

    .panel {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 20px;
      height: 100%;
    }

    .panel h5 {
      font-weight: 600;
      margin-bottom: 16px;
    }

    .stat-label {
      color: var(--text-secondary);
      font-size: 0.9rem;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .swatch {
      width: 10px;
      height: 10px;
      border-radius: 2px;
      display: inline-block;
    }

    .stat-value {
      font-size: 1.9rem;
      font-weight: 700;
      margin-top: 4px;
    }

    .stat-sub {
      color: var(--text-muted);
      font-size: 0.85rem;
    }

    .chart-wrap {
      position: relative;
      height: 320px;
    }

    .table-num {
      text-align: right;
      font-variant-numeric: tabular-nums;
    }

    .table thead th {
      color: var(--text-secondary);
      font-weight: 600;
      border-bottom-color: var(--grid);
    }

    .range-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      gap: 12px;
    }

    .range-bar .custom-range {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      gap: 8px;
    }

    .range-bar label {
      font-size: 0.8rem;
      color: var(--text-secondary);
      margin-bottom: 2px;
    }

    .net-pos { color: #b4321f; }
    .net-neg { color: #006300; }
  </style>
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="dashboard">
    <div class="dashboard-header d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
      <div>
        <h2>Dashboard</h2>
        <div class="period" id="periodLabel">Last 3 months</div>
      </div>
      <a href="/transaction" class="btn btn-primary">+ New Transaction</a>
    </div>

    <!-- Date range -->
    <div class="panel mb-4" style="height: auto">
      <div class="range-bar">
        <div class="btn-group flex-wrap" role="group" aria-label="Date range presets" id="rangePresets">
          <button type="button" class="btn btn-sm btn-outline-secondary" data-range="this-month">This month</button>
          <button type="button" class="btn btn-sm btn-outline-secondary" data-range="last-month">Last month</button>
          <button type="button" class="btn btn-sm btn-outline-secondary active" data-range="last-3-months">Last 3 months</button>
          <button type="button" class="btn btn-sm btn-outline-secondary" data-range="last-6-months">Last 6 months</button>
          <button type="button" class="btn btn-sm btn-outline-secondary" data-range="this-year">This year</button>
          <button type="button" class="btn btn-sm btn-outline-secondary" data-range="custom">Custom</button>
        </div>
        <div class="custom-range">
          <div>
            <label for="rangeFrom" class="d-block">From</label>
            <input type="date" id="rangeFrom" class="form-control form-control-sm">
          </div>
          <div>
            <label for="rangeTo" class="d-block">To</label>
            <input type="date" id="rangeTo" class="form-control form-control-sm">
          </div>
          <button type="button" class="btn btn-sm btn-primary" id="applyRange">Apply</button>
        </div>
      </div>
    </div>

    <!-- KPI tiles -->
    <div class="row g-3 mb-4">
      <div class="col-12 col-md-4">
        <div class="panel">
          <div class="stat-label"><span class="swatch" style="background: var(--cr)"></span>Purchases (CR)</div>
          <div class="stat-value" id="totalCr">—</div>
          <div class="stat-sub" id="totalCrSub">&nbsp;</div>
        </div>
      </div>
      <div class="col-12 col-md-4">
        <div class="panel">
          <div class="stat-label"><span class="swatch" style="background: var(--dr)"></span>Payments to suppliers (DR)</div>
          <div class="stat-value" id="totalDr">—</div>
          <div class="stat-sub" id="totalDrSub">&nbsp;</div>
        </div>
      </div>
      <div class="col-12 col-md-4">
        <div class="panel">
          <div class="stat-label">Net payable (CR − DR)</div>
          <div class="stat-value" id="totalNet">—</div>
          <div class="stat-sub" id="totalNetSub">&nbsp;</div>
        </div>
      </div>
    </div>

    <!-- Chart + monthly table -->
    <div class="row g-3 mb-4">
      <div class="col-12 col-lg-7">
        <div class="panel">
          <h5>Monthly purchases vs payments</h5>
          <div class="chart-wrap">
            <canvas id="crDrChart" aria-label="Monthly purchases versus payments chart" role="img"></canvas>
          </div>
        </div>
      </div>
      <div class="col-12 col-lg-5">
        <div class="panel">
          <h5>Month by month</h5>
          <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
              <thead>
                <tr>
                  <th>Month</th>
                  <th class="table-num">CR</th>
                  <th class="table-num">DR</th>
                  <th class="table-num">Net</th>
                </tr>
              </thead>
              <tbody id="monthlyBody">
                <tr><td colspan="4" class="text-center text-muted">Loading...</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- Top suppliers -->
    <div class="panel">
      <h5>Top suppliers in this period</h5>
      <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
          <thead>
            <tr>
              <th>#</th>
              <th>Supplier</th>
              <th class="table-num">Purchases (CR)</th>
              <th class="table-num">Payments (DR)</th>
              <th class="table-num">Net</th>
            </tr>
          </thead>
          <tbody id="supplierBody">
            <tr><td colspan="5" class="text-center text-muted">Loading...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
  <script>
    const fmt = (n) => Number(n || 0).toLocaleString('en-IN', { maximumFractionDigits: 2 });

    const netCell = (net) => {
      const cls = net > 0 ? 'net-pos' : net < 0 ? 'net-neg' : '';
      return `<span class="${cls}">${fmt(net)}</span>`;
    };

    const escapeHtml = (s) => String(s).replace(/[&<>"']/g, c => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    }[c]));

    function renderTiles(data) {
      const crCount = data.monthly.reduce((a, m) => a + m.crCount, 0);
      const drCount = data.monthly.reduce((a, m) => a + m.drCount, 0);

      document.getElementById('totalCr').textContent = fmt(data.totals.cr);
      document.getElementById('totalCrSub').textContent = `${crCount} invoice${crCount === 1 ? '' : 's'}`;
      document.getElementById('totalDr').textContent = fmt(data.totals.dr);
      document.getElementById('totalDrSub').textContent = `${drCount} payment${drCount === 1 ? '' : 's'}`;
      document.getElementById('totalNet').innerHTML = netCell(data.totals.net);
      document.getElementById('totalNetSub').textContent =
        data.totals.net > 0 ? 'Purchased more than paid'
        : data.totals.net < 0 ? 'Paid more than purchased'
        : 'Purchases and payments balanced';

      document.getElementById('periodLabel').textContent =
        `${rangeName} · ${formatDate(data.from)} – ${formatDate(data.to)}`;
    }

    function renderMonthlyTable(monthly) {
      document.getElementById('monthlyBody').innerHTML = monthly.map(m => `
        <tr>
          <td>${m.label}</td>
          <td class="table-num">${fmt(m.cr)}</td>
          <td class="table-num">${fmt(m.dr)}</td>
          <td class="table-num">${netCell(m.cr - m.dr)}</td>
        </tr>
      `).join('');
    }

    function renderSuppliers(suppliers) {
      const tbody = document.getElementById('supplierBody');
      if (!suppliers.length) {
        tbody.innerHTML = `<tr><td colspan="5" class="text-center text-muted">No transactions in this period</td></tr>`;
        return;
      }
      tbody.innerHTML = suppliers.map((s, i) => `
        <tr>
          <td>${i + 1}</td>
          <td>${escapeHtml(s.supplier_name)}</td>
          <td class="table-num">${fmt(s.cr)}</td>
          <td class="table-num">${fmt(s.dr)}</td>
          <td class="table-num">${netCell(s.cr - s.dr)}</td>
        </tr>
      `).join('');
    }

    let chart = null;

    function renderChart(monthly) {
      const css = getComputedStyle(document.documentElement);
      const color = (v) => css.getPropertyValue(v).trim();

      if (chart) chart.destroy();
      chart = new Chart(document.getElementById('crDrChart'), {
        type: 'bar',
        data: {
          labels: monthly.map(m => m.label),
          datasets: [
            {
              label: 'Purchases (CR)',
              data: monthly.map(m => m.cr),
              backgroundColor: color('--cr'),
              borderRadius: { topLeft: 4, topRight: 4 },
              borderSkipped: 'bottom',
              maxBarThickness: 48
            },
            {
              label: 'Payments (DR)',
              data: monthly.map(m => m.dr),
              backgroundColor: color('--dr'),
              borderRadius: { topLeft: 4, topRight: 4 },
              borderSkipped: 'bottom',
              maxBarThickness: 48
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: { mode: 'index', intersect: false },
          plugins: {
            legend: {
              position: 'top',
              align: 'start',
              labels: { color: color('--text-secondary'), boxWidth: 10, boxHeight: 10, useBorderRadius: true, borderRadius: 2 }
            },
            tooltip: {
              callbacks: {
                label: (ctx) => ` ${ctx.dataset.label}: ${fmt(ctx.parsed.y)}`,
                footer: (items) => {
                  const cr = items.find(i => i.datasetIndex === 0)?.parsed.y || 0;
                  const dr = items.find(i => i.datasetIndex === 1)?.parsed.y || 0;
                  return `Net: ${fmt(cr - dr)}`;
                }
              }
            }
          },
          scales: {
            x: {
              grid: { display: false },
              border: { color: color('--grid') },
              ticks: { color: color('--text-muted') }
            },
            y: {
              beginAtZero: true,
              grid: { color: color('--grid') },
              border: { display: false },
              ticks: { color: color('--text-muted'), callback: (v) => fmt(v) }
            }
          }
        }
      });
    }

    // ---------- Date range ----------
    const fromInput = document.getElementById('rangeFrom');
    const toInput = document.getElementById('rangeTo');
    const presetButtons = document.querySelectorAll('#rangePresets [data-range]');
    let rangeName = 'Last 3 months';
    let requestSeq = 0;

    // Local date -> "YYYY-MM-DD" for <input type="date">
    const toISODate = (d) =>
      `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;

    const formatDate = (iso) =>
      new Date(`${iso}T00:00:00`).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });

    function presetRange(name) {
      const now = new Date();
      const y = now.getFullYear(), m = now.getMonth();
      switch (name) {
        case 'this-month':    return [new Date(y, m, 1), now];
        case 'last-month':    return [new Date(y, m - 1, 1), new Date(y, m, 0)];
        case 'last-3-months': return [new Date(y, m - 2, 1), now];
        case 'last-6-months': return [new Date(y, m - 5, 1), now];
        case 'this-year':     return [new Date(y, 0, 1), now];
      }
      return null;
    }

    function setActivePreset(name) {
      presetButtons.forEach(b => b.classList.toggle('active', b.dataset.range === name));
    }

    presetButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const name = btn.dataset.range;
        setActivePreset(name);
        if (name === 'custom') {
          fromInput.focus();
          return;
        }
        const [from, to] = presetRange(name);
        fromInput.value = toISODate(from);
        toInput.value = toISODate(to);
        rangeName = btn.textContent.trim();
        loadDashboard();
      });
    });

    // Editing a date by hand switches to the custom range
    [fromInput, toInput].forEach(el => el.addEventListener('input', () => setActivePreset('custom')));

    document.getElementById('applyRange').addEventListener('click', () => {
      if (!fromInput.value || !toInput.value) return alert('Please pick both a From and a To date.');
      if (fromInput.value > toInput.value) return alert("'From' date must be before 'To' date.");
      setActivePreset('custom');
      rangeName = 'Custom range';
      loadDashboard();
    });

    async function loadDashboard() {
      const seq = ++requestSeq;
      try {
        const params = new URLSearchParams({ from: fromInput.value, to: toInput.value });
        const res = await fetch(`/api/transaction/dashboard/summary?${params}`, { cache: 'no-store' });
        if (!res.ok) throw new Error(`HTTP error ${res.status}`);
        const data = await res.json();
        if (!data.success) throw new Error(data.message || 'Failed to load dashboard');

        // Ignore responses that arrive after a newer range was requested
        if (seq !== requestSeq) return;

        renderTiles(data);
        renderMonthlyTable(data.monthly);
        renderSuppliers(data.topSuppliers);
        renderChart(data.monthly);
      } catch (err) {
        console.error(err);
        const msg = `<tr><td colspan="5" class="text-center text-danger">Error loading dashboard</td></tr>`;
        document.getElementById('monthlyBody').innerHTML = msg;
        document.getElementById('supplierBody').innerHTML = msg;
      }
    }

    // Default: last 3 months
    {
      const [from, to] = presetRange('last-3-months');
      fromInput.value = toISODate(from);
      toInput.value = toISODate(to);
    }
    loadDashboard();
  </script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
