<%- include('partials/header', { title: 'Dashboard', active: 'dashboard' }) %>

<main class="page">
  <div class="page-header">
    <div>
      <h2>Dashboard</h2>
      <div class="page-subtitle" id="periodLabel">Last 3 months</div>
    </div>
    <a href="/transaction" class="btn btn-primary">+ New Transaction</a>
  </div>

  <!-- Date range -->
  <div class="panel mb-4">
    <%- include('partials/dateRange', {
      id: 'dashboardRange',
      presets: ['this-month', 'last-month', 'last-3-months', 'last-6-months', 'this-year', 'custom'],
      active: 'last-3-months',
      showApply: true
    }) %>
  </div>

  <!-- KPI tiles -->
  <div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
      <div class="panel stat">
        <div class="stat-label"><span class="swatch swatch--cr"></span>Purchases (CR)</div>
        <div class="stat-value" id="totalCr">—</div>
        <div class="stat-sub" id="totalCrSub">&nbsp;</div>
      </div>
    </div>
    <div class="col-12 col-md-4">
      <div class="panel stat">
        <div class="stat-label"><span class="swatch swatch--dr"></span>Payments to suppliers (DR)</div>
        <div class="stat-value" id="totalDr">—</div>
        <div class="stat-sub" id="totalDrSub">&nbsp;</div>
      </div>
    </div>
    <div class="col-12 col-md-4">
      <div class="panel stat">
        <div class="stat-label">Net payable (CR − DR)</div>
        <div class="stat-value" id="totalNet">—</div>
        <div class="stat-sub" id="totalNetSub">&nbsp;</div>
      </div>
    </div>
  </div>

  <!-- Chart + monthly table -->
  <div class="row g-3 mb-4">
    <div class="col-12 col-lg-7">
      <div class="panel h-100">
        <h5>Monthly purchases vs payments</h5>
        <div class="chart-wrap">
          <canvas id="crDrChart" aria-label="Monthly purchases versus payments chart" role="img"></canvas>
        </div>
      </div>
    </div>
    <div class="col-12 col-lg-5">
      <div class="panel h-100">
        <h5>Month by month</h5>
        <div class="table-responsive">
          <table class="table table-sm table-light-head align-middle mb-0">
            <thead>
              <tr>
                <th>Month</th>
                <th class="num">CR</th>
                <th class="num">DR</th>
                <th class="num">Net</th>
              </tr>
            </thead>
            <tbody id="monthlyBody">
              <tr><td colspan="4" class="text-center text-muted">Loading...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Top suppliers -->
  <div class="panel">
    <h5>Top suppliers in this period</h5>
    <div class="table-responsive">
      <table class="table table-sm table-hover table-light-head align-middle mb-0">
        <thead>
          <tr>
            <th>#</th>
            <th>Supplier</th>
            <th class="num">Purchases (CR)</th>
            <th class="num">Payments (DR)</th>
            <th class="num">Net</th>
          </tr>
        </thead>
        <tbody id="supplierBody">
          <tr><td colspan="5" class="text-center text-muted">Loading...</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</main>

<%- include('partials/footer', { vendor: ['chart'], scripts: ['/js/pages/dashboard.js'] }) %>
