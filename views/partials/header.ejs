<%#
  Page layout start. Usage: include('partials/header', { title: 'Dashboard', active: 'dashboard' })
  `active` highlights the matching navbar link.
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= locals.title ? `${title} · AccountMate` : 'AccountMate' %></title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
    crossorigin="anonymous"
  />
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <%- include('navbar', { active: locals.active }) %>
  <%- include('toastContainer') %>
