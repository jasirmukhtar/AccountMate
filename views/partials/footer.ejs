<%#
  Page layout end. Usage: include('partials/footer', { vendor: ['chart'], scripts: ['/js/pages/dashboard.js'] })
  `vendor` picks third-party libraries by name; `scripts` are page scripts loaded last.
%>
<%
  const vendorLibs = {
    chart: ['https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js'],
    xlsx: ['https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js'],
    jspdf: [
      'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js',
      'https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js'
    ]
  };
  const sharedScripts = [
    '/js/lib/format.js',
    '/js/lib/api.js',
    '/js/components/toast.js',
    '/js/components/confirmDialog.js',
    '/js/components/supplierPicker.js',
    '/js/components/dateRangePicker.js',
    '/js/components/pagination.js',
    '/js/components/transactionForm.js',
    '/js/components/navbar.js'
  ];
%>
  <%- include('confirmModal') %>

  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
    crossorigin="anonymous"
  ></script>
<% (locals.vendor || []).forEach(name => { (vendorLibs[name] || []).forEach(src => { %>
  <script src="<%= src %>"></script>
<% }) }) %>
<% sharedScripts.concat(locals.scripts || []).forEach(src => { %>
  <script src="<%= src %>"></script>
<% }) %>
</body>
</html>
