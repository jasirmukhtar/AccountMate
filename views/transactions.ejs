<%- include('partials/header', { title: 'Transactions', active: 'transactions' }) %>

<main class="page page--medium">
  <div class="page-header">
    <h2>Transactions</h2>
    <a href="/transaction" class="btn btn-primary">+ New Transaction</a>
  </div>

  <div class="d-flex justify-content-between align-items-center mb-2">
    <small class="text-muted" id="resultSummary">&nbsp;</small>
    <button type="button" class="btn btn-sm btn-outline-secondary" id="clearFiltersBtn">Clear filters</button>
  </div>

  <div class="table-responsive">
    <table class="table table-bordered table-striped">
      <thead>
        <tr class="table-dark">
          <th>#</th>
          <th>Transaction Id</th>
          <th>Supplier</th>
          <th>Invoice No</th>
          <th>Invoice Date</th>
          <th>Payment Type</th>
          <th class="num">Amount</th>
        </tr>
        <tr class="filter-row">
          <th></th>
          <th><input type="number" class="form-control form-control-sm column-filter" data-filter="transaction_id" placeholder="Id"></th>
          <th><input type="text" class="form-control form-control-sm column-filter" data-filter="supplier" placeholder="Search supplier"></th>
          <th><input type="number" class="form-control form-control-sm column-filter" data-filter="invoice_no" placeholder="Invoice"></th>
          <th><input type="date" class="form-control form-control-sm column-filter" data-filter="invoice_date"></th>
          <th>
            <select class="form-select form-select-sm column-filter" data-filter="payment_type">
              <option value="">All</option>
              <option value="CR">CR</option>
              <option value="DR">DR</option>
            </select>
          </th>
          <th><input type="number" class="form-control form-control-sm column-filter" data-filter="amount" placeholder="Amount"></th>
        </tr>
      </thead>
      <tbody id="transactionTableBody"></tbody>
    </table>
  </div>

  <nav aria-label="Transactions pages">
    <ul class="pagination justify-content-center" id="paginationControls"></ul>
  </nav>
</main>

<!-- View / edit a transaction -->
<div class="modal fade" id="transactionModal" tabindex="-1" aria-labelledby="transactionModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="transactionModalLabel">Transaction Details</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <%- include('partials/transactionForm', { submitLabel: 'Save Changes', readOnly: true }) %>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer', { scripts: ['/js/pages/transactions.js'] }) %>
