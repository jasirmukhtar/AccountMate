<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Supplier Balances (CMYK Report)</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <style>
    body {
      background: linear-gradient(120deg, #00BCD4, #E91E63, #FFEB3B);
      background-size: 300% 300%;
      animation: gradientMove 10s ease infinite;
      font-size: 1.2rem;
      color: #212121;
    }

    @keyframes gradientMove {
      0% {
        background-position: 0% 50%;
      }

      50% {
        background-position: 100% 50%;
      }

      100% {
        background-position: 0% 50%;
      }
    }

    .container {
      margin-top: 40px;
      max-width: 850px;
      background-color: white;
      padding: 30px;
      border-radius: 20px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    }

    h2 {
      font-size: 2rem;
      font-weight: 900;
      color: #E91E63;
      text-shadow: 1px 1px #FFEB3B;
    }

    table {
      border: 2px solid #212121;
    }

    thead {
      background: linear-gradient(to right, #00BCD4, #E91E63);
      color: #fff;
    }

    tfoot {
      background-color: #FFEB3B;
      font-weight: bold;
    }

    table th,
    table td {
      font-size: 1.1rem;
      font-weight: bold;
      text-align: center;
      vertical-align: middle;
    }

    #generatePDFBtn {
      background-color: #00BCD4;
      border: none;
      font-weight: bold;
    }

    #generatePDFBtn:hover {
      background-color: #0097A7;
    }

    #toastContainer {
      position: fixed;
      top: 20px;
      right: 20px;
      z-index: 1055;
    }
  </style>
</head>

<body>
  <div class="container">
    <h2 class="text-center mb-4">Supplier Balances</h2>

    <div class="mb-3 text-end">
      <button class="btn btn-lg text-white" id="generatePDFBtn">Generate PDF</button>
    </div>

    <table class="table table-bordered table-striped" id="supplierTable">
      <thead>
        <tr>
          <th>#</th>
          <th>Supplier Name</th>
          <th>Balance</th>
        </tr>
      </thead>
      <tbody id="supplierTableBody">
        <tr>
          <td colspan="3" class="text-center">Loading...</td>
        </tr>
      </tbody>
      <tfoot>
        <tr>
          <th colspan="2" class="text-end">Total Balance</th>
          <th id="totalBalanceCell">0</th>
        </tr>
      </tfoot>
    </table>
  </div>

  <div id="toastContainer"></div>

  <!-- jsPDF -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>

  <script>
    async function loadSupplierBalances() {
      try {
        const res = await fetch('/api/supplier/balances/report', { cache: 'no-store' });
        if (!res.ok) throw new Error(`HTTP error ${res.status}`);
        const data = await res.json();

        const tbody = document.getElementById('supplierTableBody');
        tbody.innerHTML = '';

        if (!data.success || !data.suppliers || data.suppliers.length === 0) {
          tbody.innerHTML = `<tr><td colspan="3" class="text-center">No suppliers found</td></tr>`;
          document.getElementById('totalBalanceCell').textContent = 0;
          return;
        }

        data.suppliers.forEach((s, idx) => {
          const row = document.createElement('tr');
          row.innerHTML = `
        <td><strong>${idx + 1}</strong></td>
        <td><strong>${s.supplier_name}</strong></td>
        <td><strong>${Number(s.balance).toFixed(2)}</strong></td>
      `;
          tbody.appendChild(row);
        });

        document.getElementById('totalBalanceCell').innerHTML = `<strong>${Number(data.totalBalance || 0).toFixed(2)}</strong>`;

      } catch (err) {
        console.error(err);
        showToast("Error loading supplier balances", true);
        const tbody = document.getElementById('supplierTableBody');
        tbody.innerHTML = `<tr><td colspan="3" class="text-center text-danger">Error loading supplier balances</td></tr>`;
      }
    }

    document.getElementById('generatePDFBtn').addEventListener('click', () => {
      const { jsPDF } = window.jspdf;
      const doc = new jsPDF();

      // 1. Get Setup Data
      const today = new Date();
      const dateStr = today.toLocaleDateString();
      const fileDate = today.toISOString().split('T')[0];
      const totalBalanceText = document.getElementById('totalBalanceCell').textContent || "0.00";

      // 2. Prepare Table Data & Find Min/Max for Color Grading
      // We scrape the data from the DOM to ensure PDF matches screen exactly
      const rawRows = Array.from(document.querySelectorAll('#supplierTableBody tr'));

      let minBal = Infinity;
      let maxBal = -Infinity;

      const tableData = rawRows.map(row => {
        const cells = Array.from(row.children);
        const balanceVal = parseFloat(cells[2].textContent.replace(/,/g, '')); // Remove commas if any

        // Update Min/Max
        if (balanceVal < minBal) minBal = balanceVal;
        if (balanceVal > maxBal) maxBal = balanceVal;

        return [cells[0].textContent, cells[1].textContent, cells[2].textContent];
      });

      // Handle edge case if only 1 supplier or all balances are 0
      if (minBal === maxBal) maxBal = minBal + 1;

      // 3. Add Header Info
      doc.setFont("helvetica", "bold");
      doc.setFontSize(22);
      doc.setTextColor(233, 30, 99); // Brand Pink
      doc.text('Fine Cure', 14, 22);

      doc.setFontSize(11);
      doc.setTextColor(100, 100, 100); // Gray
      doc.text(`Date: ${dateStr}`, 196, 22, { align: 'right' });

      // 4. Generate Table
      doc.autoTable({
        startY: 30,
        head: [["#", "Supplier Name", "Balance"]],
        body: tableData,

        // --- FEATURE 1: Total on Last Page Only ---
        foot: [["", "TOTAL", totalBalanceText]],
        showFoot: 'lastPage',

        theme: 'grid',
        styles: {
          fontSize: 13,
          fontStyle: 'bold',
          textColor: [0, 0, 0],
          halign: 'center',
          valign: 'middle',
          lineWidth: 0.1,
          lineColor: [200, 200, 200]
        },
        headStyles: {
          fillColor: [0, 188, 212], // Cyan
          textColor: [255, 255, 255],
          fontSize: 14
        },
        footStyles: {
          fillColor: [33, 33, 33], // Dark Footer
          textColor: [255, 255, 255],
          fontSize: 14,
          halign: 'center'
        },

        // --- FEATURE 2: Conditional Color Grading (Heatmap) ---
        didParseCell: function (data) {
          // Only apply logic to the 'Body' section and the 'Balance' column (index 2)
          if (data.section === 'body' && data.column.index === 2) {

            // Parse the current cell value
            let val = parseFloat(data.cell.raw.replace(/,/g, ''));

            // Calculate position in range (0.0 to 1.0)
            let ratio = (val - minBal) / (maxBal - minBal);
            if (ratio < 0) ratio = 0;
            if (ratio > 1) ratio = 1;

            // Interpolate Color: White (255,255,255) to Red (255, 100, 100)
            // You can adjust these numbers to change the colors
            const red = 255;
            const green = Math.round(255 - (155 * ratio)); // Goes from 255 down to 100
            const blue = Math.round(255 - (155 * ratio));  // Goes from 255 down to 100

            data.cell.styles.fillColor = [red, green, blue];
          }
        }
      });

      doc.save(`supplier_balances_${fileDate}.pdf`);
    });
    // ---------- Toast ----------
    function showToast(message, isError = false) {
      const toastContainer = document.getElementById('toastContainer');
      const toast = document.createElement('div');
      toast.className = `toast align-items-center text-bg-${isError ? 'danger' : 'success'} border-0 mb-2`;
      toast.setAttribute('role', 'alert');
      toast.setAttribute('aria-live', 'assertive');
      toast.setAttribute('aria-atomic', 'true');
      toast.innerHTML = `<div class="d-flex"><div class="toast-body">${message}</div>
    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button></div>`;
      toastContainer.appendChild(toast);
      const bsToast = new bootstrap.Toast(toast, { delay: 3000 });
      bsToast.show();
      bsToast._element.addEventListener('hidden.bs.toast', () => toast.remove());
    }

    loadSupplierBalances();
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>