<%- include('partials/header', { title: 'Supplier Balances', active: 'balances-report' }) %>

<main class="page page--medium">
  <div class="page-header">
    <h2>Supplier Balances</h2>
    <button class="btn btn-primary" id="generatePDFBtn">Generate PDF</button>
  </div>

  <div class="table-responsive">
    <table class="table table-bordered table-striped" id="supplierTable">
      <thead class="table-dark">
        <tr>
          <th>#</th>
          <th>Supplier Name</th>
          <th class="num">Balance</th>
        </tr>
      </thead>
      <tbody id="supplierTableBody">
        <tr><td colspan="3" class="text-center text-muted">Loading...</td></tr>
      </tbody>
      <tfoot>
        <tr>
          <td colspan="2" class="text-end">Total Balance</td>
          <td class="num" id="totalBalanceCell">0</td>
        </tr>
      </tfoot>
    </table>
  </div>
</main>

<%- include('partials/footer', { vendor: ['jspdf'], scripts: ['/js/pages/balancesReport.js'] }) %>
